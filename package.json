{
	"name": "articledrop",
	"version": "0.3.0",
	"description": "Collect web articles and scholarly papers in Obsidian and cite them while writing.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node test/run-tests.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"package": "bash scripts/package.sh"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"article",
		"web clipper",
		"citation"
	],
	"author": "Paul Hong",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.11.0",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.21.5",
		"jsdom": "^24.1.0",
		"obsidian": "latest",
		"tslib": "^2.6.2",
		"typescript": "^5.4.5"
	},
	"dependencies": {
		"@mozilla/readability": "^0.5.0"
	}
}
