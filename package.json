{
	"name": "articledrop",
	"version": "0.3.2",
	"description": "Collect web articles and scholarly papers in Obsidian and cite them while writing.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node test/run-tests.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"package": "npm run lint && bash scripts/package.sh",
		"lint": "eslint src"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"article",
		"web clipper",
		"citation"
	],
	"author": "Paul Hong",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@eslint/json": "^0.14.0",
		"@types/node": "^20.11.0",
		"esbuild": "^0.25.12",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"jsdom": "^24.1.0",
		"obsidian": "^1.14.4",
		"tslib": "^2.6.2",
		"typescript": "^5.4.5",
		"typescript-eslint": "^8.72.1"
	},
	"dependencies": {
		"@mozilla/readability": "^0.6.0"
	}
}
